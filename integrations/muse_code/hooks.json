{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/python.exe C:/path/to/AgentWarden/hooks/on_tool.py --agent muse_code",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/python.exe C:/path/to/AgentWarden/hooks/on_read.py --agent muse_code",
            "timeout": 21
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/python.exe C:/path/to/AgentWarden/hooks/on_prompt.py --agent muse_code",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
