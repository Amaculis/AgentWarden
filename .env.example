# Copy to .env and fill in. Never commit .env.

# Meta Model API — Muse Spark (Standard tier only — never a -contributor model)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
WARDEN_MODEL=muse-spark-1.2

# Local Meta open-weights model behind an OpenAI-compatible endpoint
# (Ollama / vLLM locally, or Modal / Baseten). Filled in after the local-model spike.
WARDEN_LOCAL_BASE=http://127.0.0.1:11434/v1
WARDEN_LOCAL_MODEL=

# Cascade: off = Spark only, on = local then Spark, local_only = never escalate
WARDEN_CASCADE=on
WARDEN_ESCALATE_CONFIDENCE=0.7
WARDEN_ESCALATE_RISK_LOW=30
WARDEN_ESCALATE_RISK_HIGH=70
WARDEN_CONFIRM_DENY=false

# Injection scanner (uses the local model)
WARDEN_SCAN=on
WARDEN_SCAN_MAX_CHARS=12000

# Policy and notifications
WARDEN_POLICY=.agentwarden/policy.yaml
WARDEN_NOTIFY=on

# Daemon and time budgets (seconds)
WARDEN_URL=http://127.0.0.1:8765
WARDEN_JUDGE_TIMEOUT=6
WARDEN_DECISION_BUDGET=8
WARDEN_HOOK_TIMEOUT=10

# Meta red-team loop
REDTEAM_MAX_USD=5
