# Reference list of environment variables. Nothing loads a .env file: set these in the shell
# that starts the daemon (or as user environment variables). Never commit real keys.

# Which judge decides actions the rules did not settle:
# off (default: unsettled -> ask) | meta_api (Muse Spark only) | local | cascade
WARDEN_JUDGE=off
# Judge prompt (human-owned); default prompts/judge.md
# WARDEN_JUDGE_PROMPT=prompts/judge.md
# A model "allow" becomes "ask" above this risk (0-100) or below this confidence (0-1)
WARDEN_ALLOW_MAX_RISK=30
WARDEN_MIN_CONFIDENCE=0.6

# Meta Model API — Muse Spark (Standard tier only — never a -contributor model)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
WARDEN_MODEL=muse-spark-1.2

# Local Meta open-weights model behind an OpenAI-compatible endpoint
# (Ollama / vLLM locally, or Modal / Baseten). Filled in after the local-model spike.
WARDEN_LOCAL_BASE=http://127.0.0.1:11434/v1
WARDEN_LOCAL_MODEL=
WARDEN_LOCAL_KEY=
WARDEN_LOCAL_TIMEOUT=3

# Cascade (WARDEN_JUDGE=cascade): on = local then Spark, local_only = never escalate
WARDEN_CASCADE=on
WARDEN_ESCALATE_CONFIDENCE=0.7
WARDEN_ESCALATE_RISK_LOW=30
WARDEN_ESCALATE_RISK_HIGH=70
WARDEN_CONFIRM_DENY=false

# Injection scanner (spec 013): local (default) | meta_api | off
WARDEN_SCANNER=local
# WARDEN_SCANNER_PROMPT=prompts/scanner.md
WARDEN_SCAN_MAX_CHARS=12000
WARDEN_SCAN_TIMEOUT=7
WARDEN_SCAN_MIN_CONFIDENCE=0.5

# Policy and notifications
WARDEN_POLICY=.agentwarden/policy.yaml
WARDEN_NOTIFY=on

# Daemon and time budgets (seconds)
WARDEN_URL=http://127.0.0.1:8765
WARDEN_JUDGE_TIMEOUT=6
WARDEN_DECISION_BUDGET=7
WARDEN_HOOK_TIMEOUT=10

# Verdict cache (spec 012). Eval always caches; live sessions only with WARDEN_CACHE=on.
WARDEN_CACHE=off
# WARDEN_CACHE_PATH=~/.agentwarden/cache.sqlite
# Muse Spark price, USD per million tokens (VERIFY on dev.meta.ai), for eval cost_per_100
WARDEN_PRICE_IN=1.25
WARDEN_PRICE_OUT=4.25

# Meta red-team loop
REDTEAM_MAX_USD=5
