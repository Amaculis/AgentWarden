# Copy to .env and fill in. Never commit .env.

# Meta Model API (Standard tier only — never a -contributor model)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
WARDEN_MODEL=muse-spark-1.2

# Optional: local Meta open-weights model behind an OpenAI-compatible endpoint
WARDEN_LOCAL_BASE=
WARDEN_LOCAL_MODEL=

# Daemon
WARDEN_URL=http://127.0.0.1:8765
WARDEN_JUDGE_TIMEOUT=6
WARDEN_HOOK_TIMEOUT=8
